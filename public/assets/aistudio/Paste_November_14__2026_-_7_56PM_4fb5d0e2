<script>
  // Simple reactive tick stepper and live R recalculation
  (function() {
    const entryEl = document.getElementById('entryPriceInput');
    const stopEl = document.getElementById('stopPriceInput');
    const targetEl = document.getElementById('targetPriceInput');
    const exitEl = document.getElementById('exitPriceInput');
    const heroREl = document.getElementById('heroRealizedR');
    const heroDollarEl = document.getElementById('heroDollarPnL');
    const submitBtn = document.getElementById('submitLogButton');
    const resetBtn = document.getElementById('resetFormButton');

    function calculateMetrics() {
      const entry = parseFloat(entryEl.value) || 0;
      const stop = parseFloat(stopEl.value) || 0;
      const exit = parseFloat(exitEl.value) || 0;

      const riskPips = Math.abs(entry - stop) * 10000;
      const rewardPips = (exit - entry) * 10000;

      if (riskPips > 0) {
        const realizedR = (rewardPips / riskPips).toFixed(2);
        const dollarGain = (parseFloat(realizedR) * 1000).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        if (realizedR >= 0) {
          heroREl.textContent = `+${realizedR} R`;
          heroREl.className = "font-display-lg text-display-lg font-bold text-secondary tracking-tight";
          heroDollarEl.textContent = `+$${dollarGain}`;
          heroDollarEl.className = "font-headline-md text-headline-md font-semibold text-secondary font-label-data tracking-tight";
        } else {
          heroREl.textContent = `${realizedR} R`;
          heroREl.className = "font-display-lg text-display-lg font-bold text-error tracking-tight";
          heroDollarEl.textContent = `-$${Math.abs(parseFloat(realizedR) * 1000).toFixed(2)}`;
          heroDollarEl.className = "font-headline-md text-headline-md font-semibold text-error font-label-data tracking-tight";
        }
      }
    }

    [entryEl, stopEl, targetEl, exitEl].forEach(input => {
      if (input) {
        input.addEventListener('input', calculateMetrics);
      }
    });

    // Keyboard shortcut listeners
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) {
        e.preventDefault();
        submitBtn.click();
      } else if (e.key === 'Escape') {
        resetBtn.click();
      }
    });

    if (submitBtn) {
      submitBtn.addEventListener('click', () => {
        submitBtn.classList.add('scale-[0.98]');
        setTimeout(() => submitBtn.classList.remove('scale-[0.98]'), 150);
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        entryEl.value = '1.08450';
        stopEl.value = '1.08350';
        targetEl.value = '1.08750';
        exitEl.value = '1.08720';
        calculateMetrics();
      });
    }
  })();
</script></div></main></div></body></html>